# Database
DATABASE_URL="mysql://root:password@localhost:3306/mabiguild"

# App
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth
# Lucia auth uses the database adapter, no extra secret needed
# But we need a session secret for cookie signing
SESSION_SECRET="replace-with-long-random-secret-32-chars-min"

# Environment
NODE_ENV="development"
